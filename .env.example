# Existing browser nonce/envelope key, NOT AUTHENTICATION_SECRET.
# Browser-visible. Vite injects it into static HTML under field hash at build.
# For Vite development only. Docker injects STUDIO_HASH/STUDIO_API_BASE below at startup.
VITE_STUDIO_HASH=
# Existing Node API base, matching webapp VITE_PUBLIC_CHATTERLOOP_API.
# /rt is required at the production gateway; /us belongs to Django.
VITE_STUDIO_API_BASE=https://api.chatterloop.app/rt

# Container runtime (env_file in your Swarm stack). No rebuild needed when changed.
STUDIO_HASH=
STUDIO_API_BASE=https://api.chatterloop.app/rt

# Set to the deployed IMAGE_TAG in the Swarm environment; displayed in the footer.
VITE_PUBLIC_APP_VERSION=dev
