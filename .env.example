# Existing browser nonce/envelope key, NOT AUTHENTICATION_SECRET.
# Browser-visible. Vite injects it into static HTML under field hash at build.
# For Vite development only. Docker injects STUDIO_HASH/STUDIO_API_BASE below at startup.
VITE_STUDIO_HASH=
# Existing Node API origin/base URL, e.g. https://api.chatterloop.app
VITE_STUDIO_API_BASE=

# Container runtime (env_file in your Swarm stack). No rebuild needed when changed.
STUDIO_HASH=
STUDIO_API_BASE=
