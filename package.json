{
  "name": "chatterloop-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && node scripts/copy-ffmpeg.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/contracts.test.mjs tests/engine.test.mjs tests/container.test.mjs tests/timeline.test.mjs tests/geometry.test.mjs tests/workflow.test.mjs",
    "postinstall": "node scripts/copy-ffmpeg.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/core-mt": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "lucide-react": "0.274.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.3",
    "vite": "6.4.1"
  }
}
